# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="AI Data Analyst Agent"
APP_ENV=development           # development | staging | production
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-in-production-use-256-bit-random-string

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# ── Frontend ──────────────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
BACKEND_URL=http://localhost:8000

# ── LLM Provider — Groq ───────────────────────────────────────────────────────
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Available Groq models:
#   llama-3.3-70b-versatile    ← default, best quality
#   llama-3.1-8b-instant       ← fastest (lowest latency)
#   mixtral-8x7b-32768         ← long-context tasks
#   gemma2-9b-it               ← lightweight
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
REPORTS_DIR=./data/reports
MAX_UPLOAD_SIZE_MB=100

# ── Azure (Production) ────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=rg-ai-data-analyst
AZURE_ACR_NAME=acrdataanalyst
AZURE_APP_SERVICE_PLAN=asp-ai-data-analyst
AZURE_WEBAPP_NAME=ai-data-analyst
AZURE_WEBAPP_BACKEND=ai-data-analyst-api
AZURE_LOCATION=eastus

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text               # json | text
LOG_DIR=./logs
